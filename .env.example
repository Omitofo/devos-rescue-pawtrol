# =============================================================================
# Rescue Pawtrol — Environment Configuration (WP-01 + WP-09 + WP-10)
# =============================================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing secrets.
#
# NFR-02: Service-role key must NEVER appear in client-side code or NEXT_PUBLIC_*.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe (WP-09 — Checkout & payments)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# POD / print-on-demand (WP-10) — optional
# -----------------------------------------------------------------------------
# Preference: Gelato → Printify → Printful → mock (no keys).
# Without keys, "Submit to POD" uses the mock provider (safe for local/dev).
# POD_FORCE_MOCK=1
# POD_AUTO_SUBMIT=1
# GELATO_API_KEY=
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=
# PRINTFUL_API_KEY=

# -----------------------------------------------------------------------------
# Future
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER_API_KEY=

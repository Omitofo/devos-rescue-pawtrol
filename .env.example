# =============================================================================
# Rescue Pawtrol — Environment Configuration (WP-01)
# =============================================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing secrets.
#
# NFR-02: Service-role key must NEVER appear in client-side code or NEXT_PUBLIC_*.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Project URL — visible in Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to expose to the browser. Used by client & server
# when acting on behalf of an anonymous or authenticated user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Bypasses RLS. Used exclusively in
# Route Handlers, Server Actions, and Edge Functions that need elevated access.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public site URL (used for redirects, absolute links, health checks, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment (set automatically by Next.js / hosting platform)
# NODE_ENV=development | production | test

# -----------------------------------------------------------------------------
# Future (placeholders — do not fill until the corresponding WP)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# POD_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
